# Postgres connection. Leave empty to use the local file store.
# Example: postgres://postgres:YOUR_PASSWORD@localhost:5432/ukuri
DATABASE_URL=

# Escalation rules
SUSPICIOUS_LIMIT=8
CUE_LIMIT=5
ESCALATION_WINDOW_MINUTES=10

VITE_API_URL=/api
VITE_USE_BACKEND=true
VITE_MODEL_THRESHOLD=0.6
VITE_MODEL_RESIZE=squash
